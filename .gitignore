# --- secrets ----------------------------------------------------------------
# Never commit private keys or API tokens.
*.key
*.pem.key
ca/*.key
ca/*-private*
ca/.private/
vast_api_key
vast_api_key.txt
runpod_api_key
runpod_api_key.txt
.env
.env.*
!.env.example

# --- AOSP build outputs (massive, regenerated on every build) ---------------
out/
out-*/
ccache/
.ccache/
.repo/
src/
mirror/

# --- Vast.ai state ----------------------------------------------------------
vast/.instance_id
vast/.last_offer
vast/known_hosts

# --- RunPod state -----------------------------------------------------------
runpod/.pod_id
runpod/known_hosts

# --- Editor / OS noise ------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# --- Logs and tmp -----------------------------------------------------------
logs/
*.log
tmp/
.tmp/

# --- Third-party clones (not submodules; each retains its own .git/) --------
# `third_party/` is a working dropbox for upstream code we read but do not
# vendor. Every dir inside has its own .git/ and is fetched on demand.
third_party/

# --- MDF runtime state (per-pod) --------------------------------------------
mdf/.mdf_pod_id
mdf/.last_provision

# --- command-center node_modules / build artifacts --------------------------
command-center/**/node_modules/
command-center/**/dist/
command-center/.local/

# --- OTA local state --------------------------------------------------------
ota/site/_redirects.local
ota/.local/

# --- perf-baseline raw captures ---------------------------------------------
docs/perf-*.tsv

# --- Python bytecode --------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- Cloudflare Wrangler / Workers ------------------------------------------
.wrangler/
wrangler-tail.log

# --- generated keystores / signing -----------------------------------------
*.keystore
*.jks
ota/keys/private/
ota/.signing-cache/
