<?xml version="1.0" encoding="UTF-8"?>
<!--
  repo local_manifest fragment.

  This file is copied into <SRC_DIR>/.repo/local_manifests/ by init.sh before
  `repo sync`, so any extra projects we want pulled into the AOSP source tree
  show up alongside the official manifest.

  As of v0, our device tree is splice-copied by hooks/after-sync.sh from the
  bind-mounted /srv/devicetree (host => container), NOT pulled by repo. That
  means we don't actually need any <project/> entries here yet -- but we keep
  this file so the override mechanism is documented and ready.

  When/if we move our device tree into its own git repo (recommended once
  it's stable), the <project/> entry below is the form to use.
-->
<manifest>
    <!--
    <remote name="techsumit"
            fetch="https://github.com/tech-sumit/"
            review="https://github.com/tech-sumit/" />

    <project name="android_device_customos_customphone"
             path="device/customos/customphone"
             remote="techsumit"
             revision="main" />
    -->
</manifest>
