<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid MayaOS-purple background tile for the adaptive launcher icon.
  Adaptive icons render the inner 66x66 of a 108x108 canvas inside the
  launcher's mask, so a flat fill is the cheapest correct option (no
  scaling/aliasing concerns across DPI buckets).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#673AB7" />
    <size
        android:width="108dp"
        android:height="108dp" />
</shape>
